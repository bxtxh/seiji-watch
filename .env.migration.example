# Airtable to Supabase Migration Configuration
# Copy this file to .env.staging or .env.production and fill in the values

# =======================
# Migration Phase Settings
# =======================
# Phase 1: Read-only migration (Supabase for reads, Airtable for writes)
# Phase 2: Selective migration (Some writes to Supabase)
# Phase 3: Full migration (All operations on Supabase)
MIGRATION_PHASE=1

# =======================
# Airtable Configuration
# =======================
# Personal Access Token (PAT) - Required
# Get from: https://airtable.com/create/tokens
AIRTABLE_PAT=patXXXXXXXXXXXXXX

# Base ID - Required
# Find in Airtable URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Rate limiting
AIRTABLE_RATE_LIMIT=5  # requests per second

# =======================
# Supabase Configuration
# =======================
# Project URL - Required
# Find in Supabase dashboard: Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Anonymous Key - Required for public access
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key - Required for admin operations
# KEEP THIS SECRET - Has full database access
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database URL - Required for direct database access
# Format: postgresql://postgres:[password]@[host]:[port]/postgres
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# Connection pool settings
SUPABASE_DB_POOL_MIN=2
SUPABASE_DB_POOL_MAX=10
SUPABASE_DB_POOL_IDLE_TIMEOUT=30000

# =======================
# Redis Configuration
# =======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Optional
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# Cache TTL settings (in seconds)
CACHE_TTL_SHORT=60      # 1 minute - for frequently changing data
CACHE_TTL_MEDIUM=300    # 5 minutes - for moderately changing data
CACHE_TTL_LONG=3600     # 1 hour - for rarely changing data

# =======================
# Feature Flags
# =======================
# Control migration behavior
FEATURE_SUPABASE_READ_ENABLED=true
FEATURE_SUPABASE_WRITE_ENABLED=false  # Set to true in Phase 2/3
FEATURE_AIRTABLE_FALLBACK_ENABLED=true
FEATURE_CACHE_ENABLED=true
FEATURE_MONITORING_ENABLED=true

# =======================
# Sync Configuration
# =======================
# Sync mode: incremental, full, or real_time
SYNC_MODE=incremental

# Sync interval in minutes
SYNC_INTERVAL_MINUTES=5

# Batch size for sync operations
SYNC_BATCH_SIZE=100

# Conflict resolution: airtable_priority, supabase_priority, or timestamp
CONFLICT_RESOLUTION=airtable_priority

# Tables to sync (comma-separated, or empty for all)
SYNC_TABLES=

# =======================
# Migration Settings
# =======================
# Batch size for initial migration
MIGRATION_BATCH_SIZE=100

# Check interval for migration worker (seconds)
CHECK_INTERVAL_SECONDS=300

# Validation threshold (percentage)
VALIDATION_THRESHOLD=95

# =======================
# Monitoring Configuration
# =======================
# Monitoring port
MONITORING_PORT=8080

# Metrics port (Prometheus)
METRICS_PORT=9090

# Alert thresholds
ALERT_SYNC_LAG_MINUTES=30
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_CONSISTENCY_THRESHOLD=0.95

# Metrics retention (days)
METRICS_RETENTION_DAYS=30

# =======================
# Authentication
# =======================
# JWT secret for migration API
MIGRATION_JWT_SECRET=your-very-secure-jwt-secret-key-change-in-production

# Admin credentials
MIGRATION_ADMIN_EMAIL=admin@seiji-watch.jp
MIGRATION_ADMIN_PASSWORD=change-this-secure-password-in-production

# =======================
# Logging
# =======================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=/app/logs

# =======================
# Backup Configuration
# =======================
# Backup directory
BACKUP_DIR=/app/backups

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# =======================
# API Configuration
# =======================
# API port for migration endpoints
API_PORT=8081

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://seiji-watch.jp

# =======================
# Environment Settings
# =======================
# Environment: development, staging, or production
ENVIRONMENT=staging

# Debug mode
DEBUG=false

# =======================
# Performance Tuning
# =======================
# Max concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Retry settings
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1