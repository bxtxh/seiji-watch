FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    postgresql-client \
    redis-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.migration.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.migration.txt

# Copy application code
COPY shared/ /app/shared/
COPY scripts/ /app/scripts/

# Create necessary directories
RUN mkdir -p /app/logs /app/backups /app/data

# Set Python path
ENV PYTHONPATH=/app/shared/src:/app
ENV PYTHONUNBUFFERED=1

# Create non-root user
RUN useradd -m -u 1000 migration && \
    chown -R migration:migration /app

USER migration

# Default command
CMD ["python3", "/app/scripts/migration_worker.py"]